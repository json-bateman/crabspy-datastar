package web

templ Login(errMsg string) {
	@Base("Login") {
		<main id="morphTarget">
			<div class="mt-4 flex-col w-full items-center">
				<div style="inline-size: 80px; block-size: 80px;">
					<img class="w-full contain pixelated" src={ StaticPath("images/player-crabs/tourist-crab.png") }/>
				</div>
				<h3>We're so back</h3>
				<div class="flex-col mt-4">
					<label for="login-name">Name</label>
					<input
						id="login-name"
						name="login-name"
						autocomplete="nickname"
						if errMsg != "" {
							class="input input-error"
						} else {
							class="input input-accent"
						}
						type="text"
						maxlength="12"
						data-on:keydown={ `
                            if (evt.key !== 'Enter' || !$name.trim().length) {
                                return;
                            };
                            @post('/login');
                        ` }
						required
						data-bind:name
						aria-live="polite"
						aria-describedby="name"
					/>
				</div>
				<div class="flex-col mb-2">
					<label for="login-secret">Secret phrase (optional)</label>
					<input
						id="login-secret"
						name="login-secret"
						autocomplete="current-password"
						if errMsg != "" {
							class="input input-error"
						} else {
							class="input input-accent"
						}
						type="password"
						data-on:keydown={ `
                            if (evt.key !== 'Enter' || !$name.trim().length) {
                                return;
                            };
                            @post('/login');
                        ` }
						data-bind:secret
						aria-live="polite"
						aria-describedby="secret"
					/>
				</div>
				<span class="text-xs opacity-50" style="max-inline-size: var(--size-14); text-align: center;">
					Type the same secret next time to keep your crab. Leave it blank to play as a fresh crab.
				</span>
				<button class="btn btn-accent shadow mt-2" data-on:click="@post('/login')">Play</button>
				if errMsg != "" {
					<div class="color-error">{ errMsg }</div>
				}
			</div>
			<div
				class="text-xs color-text opacity-50"
				title="deployed commit"
				style="position: fixed; inset-block-end: var(--size-2); inset-inline: 0; text-align: center;"
			>
				{ CommitLabel() }
			</div>
		</main>
	}
}
